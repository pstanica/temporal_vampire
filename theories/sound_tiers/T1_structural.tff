% ==============================================================================
% SOUND GREGORIAN TEMPORAL THEORY -- GENERATED ARTIFACT
% Generated by scripts/build_sound_tiers.py
% Intended years are positive Gregorian years (proleptic Gregorian semantics).
% IMPORTANT: Historical Best0/Best1/SAFE_HEAVY files are preserved separately
% and are not the formal T1/T2/T3 files used in the new experiments.
% ==============================================================================

% --- Types and constructors ---
tff(t_date, type, date: $tType).
tff(t_ymd, type, ymd: ($int * $int * $int) > date).
tff(t_day_name, type, day_name: $tType).
tff(dn_sun, type, sunday: day_name).
tff(dn_mon, type, monday: day_name).
tff(dn_tue, type, tuesday: day_name).
tff(dn_wed, type, wednesday: day_name).
tff(dn_thu, type, thursday: day_name).
tff(dn_fri, type, friday: day_name).
tff(dn_sat, type, saturday: day_name).

tff(day_names_distinct, axiom,
  $distinct(sunday,monday,tuesday,wednesday,thursday,friday,saturday)).

tff(ymd_injective, axiom,
  ![Y1:$int,M1:$int,D1:$int,Y2:$int,M2:$int,D2:$int]:
    (ymd(Y1,M1,D1)=ymd(Y2,M2,D2) => (Y1=Y2 & M1=M2 & D1=D2))).

% --- Structural predicates ---
tff(t_leap, type, is_leap_year: $int > $o).
tff(t_dim, type, is_days_in_month: ($int * $int * $int) > $o).
tff(t_diy, type, is_days_in_year: ($int * $int) > $o).
tff(t_valid_date, type, valid_date: ($int * $int * $int) > $o).
tff(t_weekday, type, weekday: (date * day_name) > $o).
tff(t_map_i2n, type, map_iso: ($int * day_name) > $o).
tff(t_map_n2i, type, map_name_to_int: (day_name * $int) > $o).

% Gregorian leap-year rule, stated as a definition for positive years.
tff(leap_year_def, axiom,
  ![Y:$int]:
   (is_leap_year(Y) <=>
    ($greater(Y,0) & $remainder_e(Y,4)=0 &
      ($remainder_e(Y,100)!=0 | $remainder_e(Y,400)=0)))).

% Month-length relation is exact, not merely one-way.
tff(month_1_def, axiom, ![Y:$int,L:$int]: (is_days_in_month(1,Y,L) <=> L=31)).
tff(month_2_def, axiom,
  ![Y:$int,L:$int]:
   (is_days_in_month(2,Y,L) <=>
    ((is_leap_year(Y) & L=29) | (~is_leap_year(Y) & L=28)))).
tff(month_3_def, axiom, ![Y:$int,L:$int]: (is_days_in_month(3,Y,L) <=> L=31)).
tff(month_4_def, axiom, ![Y:$int,L:$int]: (is_days_in_month(4,Y,L) <=> L=30)).
tff(month_5_def, axiom, ![Y:$int,L:$int]: (is_days_in_month(5,Y,L) <=> L=31)).
tff(month_6_def, axiom, ![Y:$int,L:$int]: (is_days_in_month(6,Y,L) <=> L=30)).
tff(month_7_def, axiom, ![Y:$int,L:$int]: (is_days_in_month(7,Y,L) <=> L=31)).
tff(month_8_def, axiom, ![Y:$int,L:$int]: (is_days_in_month(8,Y,L) <=> L=31)).
tff(month_9_def, axiom, ![Y:$int,L:$int]: (is_days_in_month(9,Y,L) <=> L=30)).
tff(month_10_def, axiom, ![Y:$int,L:$int]: (is_days_in_month(10,Y,L) <=> L=31)).
tff(month_11_def, axiom, ![Y:$int,L:$int]: (is_days_in_month(11,Y,L) <=> L=30)).
tff(month_12_def, axiom, ![Y:$int,L:$int]: (is_days_in_month(12,Y,L) <=> L=31)).
tff(month_domain, axiom,
  ![M:$int,Y:$int,L:$int]:
   (is_days_in_month(M,Y,L) => ($lesseq(1,M) & $lesseq(M,12)))).

tff(year_length_def, axiom,
  ![Y:$int,L:$int]:
   (is_days_in_year(Y,L) <=>
    ((is_leap_year(Y) & L=366) | (~is_leap_year(Y) & $greater(Y,0) & L=365)))).

tff(valid_date_def, axiom,
  ![Y:$int,M:$int,D:$int]:
   (valid_date(Y,M,D) <=>
    ($greater(Y,0) & ?[L:$int]:
      (is_days_in_month(M,Y,L) & $greater(D,0) & $lesseq(D,L))))).

% Weekday code used by the Gregorian form of Zeller's congruence:
% 0=Saturday, 1=Sunday, ..., 6=Friday.
tff(map_i0, axiom, map_iso(0,saturday)).
tff(map_i1, axiom, map_iso(1,sunday)).
tff(map_i2, axiom, map_iso(2,monday)).
tff(map_i3, axiom, map_iso(3,tuesday)).
tff(map_i4, axiom, map_iso(4,wednesday)).
tff(map_i5, axiom, map_iso(5,thursday)).
tff(map_i6, axiom, map_iso(6,friday)).
tff(map_n0, axiom, map_name_to_int(saturday,0)).
tff(map_n1, axiom, map_name_to_int(sunday,1)).
tff(map_n2, axiom, map_name_to_int(monday,2)).
tff(map_n3, axiom, map_name_to_int(tuesday,3)).
tff(map_n4, axiom, map_name_to_int(wednesday,4)).
tff(map_n5, axiom, map_name_to_int(thursday,5)).
tff(map_n6, axiom, map_name_to_int(friday,6)).
tff(map_iso_functional, axiom,
  ![I:$int,N1:day_name,N2:day_name]:
   ((map_iso(I,N1) & map_iso(I,N2)) => N1=N2)).
tff(map_name_functional, axiom,
  ![N:day_name,I1:$int,I2:$int]:
   ((map_name_to_int(N,I1) & map_name_to_int(N,I2)) => I1=I2)).
tff(weekday_functional, axiom,
  ![Dt:date,N1:day_name,N2:day_name]:
   ((weekday(Dt,N1) & weekday(Dt,N2)) => N1=N2)).

% Zeller, January/February. The displayed and encoded formula both use -2J.
tff(zeller_janfeb, axiom,
 ![Y:$int,M:$int,D:$int,Name:day_name,ZY:$int,ZM:$int,K:$int,J:$int,
   T1:$int,T2:$int,H:$int]:
  ((valid_date(Y,M,D) & (M=1 | M=2) &
    ZY=$difference(Y,1) & ZM=$sum(M,12) &
    K=$remainder_e(ZY,100) & J=$quotient_e(ZY,100) &
    T1=$quotient_e($product(13,$sum(ZM,1)),5) &
    T2=$difference(
         $sum(D,$sum(T1,$sum(K,$sum($quotient_e(K,4),$quotient_e(J,4))))),
         $product(2,J)) &
    H=$remainder_e(T2,7) & map_iso(H,Name))
   => weekday(ymd(Y,M,D),Name))).

% Zeller, March--December.
tff(zeller_mardec, axiom,
 ![Y:$int,M:$int,D:$int,Name:day_name,K:$int,J:$int,T1:$int,T2:$int,H:$int]:
  ((valid_date(Y,M,D) & $lesseq(3,M) & $lesseq(M,12) &
    K=$remainder_e(Y,100) & J=$quotient_e(Y,100) &
    T1=$quotient_e($product(13,$sum(M,1)),5) &
    T2=$difference(
         $sum(D,$sum(T1,$sum(K,$sum($quotient_e(K,4),$quotient_e(J,4))))),
         $product(2,J)) &
    H=$remainder_e(T2,7) & map_iso(H,Name))
   => weekday(ymd(Y,M,D),Name))).
