tff(anchor_span_1776_4, axiom, year_span_days(1776,4,1461)).
tff(anchor_span_1776_10, axiom, year_span_days(1776,10,3653)).
tff(anchor_span_1776_100, axiom, year_span_days(1776,100,36524)).
tff(anchor_span_1776_400, axiom, year_span_days(1776,400,146097)).
tff(anchor_span_1900_4, axiom, year_span_days(1900,4,1460)).
