tff(anchor_span_1600_4, axiom, year_span_days(1600,4,1461)).
tff(anchor_span_1600_10, axiom, year_span_days(1600,10,3653)).
tff(anchor_span_1600_100, axiom, year_span_days(1600,100,36525)).
